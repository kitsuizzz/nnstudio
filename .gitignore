# nnstudio — what stays out of git

# secrets and machine-local settings
.env
.env.*
.opencode/
*.key
*.pem
*.p12
*.crt
id_rsa*
.netrc
.git-credentials

# environments and caches
.venv/
__pycache__/
*.pyc
.cache/
.huggingface/
.hf_token
.ipynb_checkpoints/
.DS_Store

# weights and models (tens of GB, never in git)
models
models/
weights
weights/
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.onnx

# runtime output: task rows, agent streams, checkpoints, media, logs
agents/
checkpoints/
datasets/
blobs/
media/
uploads/
runs/
outputs/
logs/
*.log
users.db*
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
