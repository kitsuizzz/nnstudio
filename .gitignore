# nnstudio — what stays out of git

# secrets and machine-local settings
.env
.env.*
.opencode/
*.key
*.pem
*.p12
*.crt
id_rsa*
.netrc
.git-credentials

# environments and caches
.venv/
__pycache__/
*.pyc
.cache/
.huggingface/
.hf_token
.ipynb_checkpoints/
.DS_Store

# weights and models (tens of GB, never in git)
models
models/
weights
weights/
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.ckpt
*.onnx

# runtime output: task rows, agent streams, checkpoints, media, logs
agents/
checkpoints/
datasets/
blobs/
media/
uploads/
runs/
outputs/
logs/
*.log
# no database file is ever tracked: each one is derived (hf_arc.db is rebuilt
# by the reverse agent) or private (users.db — sealed accounts and designs)
*.db
users.db*
*.db-journal
.certs/
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# the Chat half's build (studio/README.md: VITE_BASE_PATH=chat npm run build)
studio/frontend/dist/
studio/frontend/node_modules/
studio/frontend/tsconfig.tsbuildinfo
studio/backend/.venv/
studio/backend/__pycache__/
