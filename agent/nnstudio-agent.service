[Unit]
Description=nnstudio agent — this pc as the canvas's backend (torch runner)
After=network-online.target
Wants=nnstudio.service

[Service]
# %h is the user's home — this expects the repo at ~/nnstudio; edit for another place
Type=simple
WorkingDirectory=%h/nnstudio
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/nnstudio/.venv/bin/python %h/nnstudio/agent/nnstudio_agent.py --app 127.0.0.1:8125
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
